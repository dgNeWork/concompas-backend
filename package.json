{
  "name": "concompas-backend",
  "version": "1.0.0",
  "description": "API REST - Node.js + Express + TypeScript. Plataforma de intermediación que conecta clientes con taxistas en la provincia de Cádiz, de momento... Gestiona reservas de trayectos, tours turísticos y servicios por eventos, con pagos integrados vía Stripe.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgNeWork/concompas-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dgNeWork/concompas-backend/issues"
  },
  "homepage": "https://github.com/dgNeWork/concompas-backend#readme",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@supabase/supabase-js": "^2.99.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.jest.json" }]
    },
    "moduleFileExtensions": ["ts", "js", "json"],
    "moduleNameMapper": {
      "^@nestjs/common$": "<rootDir>/../test-mocks/nestjs-common.js"
    },
    "setupFiles": ["<rootDir>/../jest.setup.js"],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.types.ts",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
